# Copy this file to ".env" and fill in your own values.
# The ".env" file holds all secrets and is never committed to git.

# --- Flask ---
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Set to true when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=service_expert

# --- Galli Maps ---
# Get an access token from https://gallimaps.com after registering.
GALLI_ACCESS_TOKEN=your-galli-maps-access-token

# --- Khalti payment gateway ---
# Sandbox: sign up at https://test-admin.khalti.com/#/join/merchant (OTP 987654)
# and copy the "live secret key" shown there - despite the name it is the
# sandbox key. It is used only by the Flask server, never sent to the browser.
KHALTI_SECRET_KEY=your-khalti-sandbox-secret-key
KHALTI_BASE_URL=https://a.khalti.com/api/v2/

# --- Email and password recovery ---
# Public origin users open in their browser. Do not include a trailing slash.
RESET_BASE_URL=http://127.0.0.1:5000
RESET_TOKEN_TTL_MINUTES=30
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_FROM=no-reply@example.com
MAIL_USE_TLS=true
MAIL_USE_SSL=false

# --- Sample data ---
# Password given to every demo account created by seed_data.py.
SEED_PASSWORD=Demo@1234
